# Facoltativo. Senza .env l'app usa il backend VERO Base44, in modalità prova (sola lettura).
#
# Togliere la modalità prova (l'app potrà salvare sui dati veri):
# EXPO_PUBLIC_BASE44_READONLY=0
#
# Stack di prova locale con dati sintetici (scripts/local/dev_stack.sh), per sviluppo e confronti:
# EXPO_PUBLIC_BACKEND=local
# EXPO_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
# EXPO_PUBLIC_SUPABASE_ANON_KEY=dev
