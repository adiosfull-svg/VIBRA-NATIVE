{
  "name": "PromoterNote",
  "type": "object",
  "properties": {
    "promoter_id": {
      "type": "string",
      "description": "ID del promoter a cui appartiene la nota"
    },
    "title": {
      "type": "string",
      "description": "Titolo della nota"
    },
    "content": {
      "type": "string",
      "description": "Contenuto testuale della nota"
    },
    "color": {
      "type": "string",
      "description": "Colore della nota (hex o nome)",
      "default": "#1e1e2e"
    },
    "pinned": {
      "type": "boolean",
      "description": "Nota in evidenza",
      "default": false
    },
    "display_order": {
      "type": "number",
      "description": "Ordine di visualizzazione per drag & drop",
      "default": 0
    }
  },
  "required": [
    "promoter_id"
  ]
}