{
  "name": "ProgrammazionePlan",
  "type": "object",
  "properties": {
    "promoter_id": {
      "type": "string",
      "description": "ID del promoter proprietario del prospetto (una riga per promoter)"
    },
    "plan": {
      "type": "object",
      "description": "Blob del prospetto inviti: { [dateStr]: { title, subtitle, clients: [{ id, name, note, type, ig }] } }",
      "additionalProperties": true
    }
  },
  "required": [
    "promoter_id"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "capogruppo"
          }
        },
        {
          "user_condition": {
            "role": "pr"
          }
        },
        {
          "user_condition": {
            "role": "super4"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "data.promoter_id": "{{user.data.promoter_id}}"
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "data.promoter_id": "{{user.data.promoter_id}}"
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "data.promoter_id": "{{user.data.promoter_id}}"
        }
      ]
    }
  }
}