{
  "name": "Comitiva",
  "properties": {
    "client_ids": {
      "description": "ID dei propri paganti inseriti nella comitiva",
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "color": {
      "default": "#a78bfa",
      "description": "Colore hex della comitiva",
      "type": "string"
    },
    "external_client_ids": {
      "description": "ID dei paganti di ALTRI promoter inseriti nella comitiva (solo nome/zona visibili)",
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "external_meta": {
      "additionalProperties": true,
      "description": "Istantanea minima dei nodi esterni: { [id]: { kind: 'ext'|'promoter', name, residenza_key, promoter_id, photo_url } }. Niente dati personali (rating, spese, presenze).",
      "type": "object"
    },
    "group_ids": {
      "description": "ID dei Gruppi (ClientGroup) importati nella comitiva",
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "name": {
      "description": "Nome della comitiva (es. 'Comitiva Vomero')",
      "type": "string"
    },
    "notes": {
      "description": "Note sulla comitiva",
      "type": "string"
    },
    "positions": {
      "additionalProperties": true,
      "description": "Posizioni delle card sull'editor: { [node_id]: { x, y } }",
      "type": "object"
    },
    "promoter_id": {
      "description": "ID del promoter proprietario della comitiva",
      "type": "string"
    },
    "promoter_ids": {
      "description": "ID dei Promoter Vibra inseriti nella comitiva",
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "sizes": {
      "additionalProperties": true,
      "description": "Dimensione (importanza nella comitiva) delle card: { [node_id]: scala } con scala tra 0.7 e 1.6 (1 = normale)",
      "type": "object"
    }
  },
  "required": [
    "promoter_id",
    "name"
  ],
  "type": "object",
  "rls": {
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "capogruppo"
          }
        },
        {
          "user_condition": {
            "role": "pr"
          }
        },
        {
          "user_condition": {
            "role": "super4"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "data.promoter_id": "{{user.data.promoter_id}}"
        }
      ]
    },
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "data.promoter_id": "{{user.data.promoter_id}}"
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "data.promoter_id": "{{user.data.promoter_id}}"
        }
      ]
    }
  }
}
