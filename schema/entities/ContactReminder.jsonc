{
  "name": "ContactReminder",
  "type": "object",
  "properties": {
    "promoter_id": {
      "type": "string",
      "description": "ID del promoter proprietario del promemoria"
    },
    "client_id": {
      "type": "string",
      "description": "ID del cliente da ricontattare"
    },
    "client_name": {
      "type": "string",
      "description": "Nome del cliente (per display rapido senza join)"
    },
    "reminder_datetime": {
      "type": "string",
      "format": "date-time",
      "description": "Data e ora del promemoria (ISO 8601)"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "sent",
        "cancelled"
      ],
      "default": "pending",
      "description": "Stato del promemoria: pending = in attesa, sent = notifica inviata, cancelled = annullato"
    }
  },
  "required": [
    "promoter_id",
    "client_id",
    "reminder_datetime"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "capogruppo"
          }
        },
        {
          "user_condition": {
            "role": "pr"
          }
        },
        {
          "user_condition": {
            "role": "super4"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "data.promoter_id": "{{user.data.promoter_id}}"
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "data.promoter_id": "{{user.data.promoter_id}}"
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "data.promoter_id": "{{user.data.promoter_id}}"
        }
      ]
    }
  }
}