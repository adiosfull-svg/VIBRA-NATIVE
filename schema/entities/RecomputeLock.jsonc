{
  "name": "RecomputeLock",
  "type": "object",
  "properties": {
    "key": {
      "type": "string",
      "description": "Chiave del job (es. 'cumulative_stats')"
    },
    "token": {
      "type": "string",
      "description": "Token dell'ultima richiesta di ricalcolo: solo la richiesta con il token corrente esegue il lavoro (debounce)"
    }
  },
  "required": [
    "key"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}