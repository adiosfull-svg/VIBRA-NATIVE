{
  "name": "ClientMapLayout",
  "properties": {
    "positions": {
      "additionalProperties": true,
      "description": "Posizioni dei clienti sulla mappa Legami: { [client_id]: { x, y } }",
      "type": "object"
    },
    "promoter_id": {
      "description": "ID del promoter proprietario della mappa Legami (una riga per promoter)",
      "type": "string"
    }
  },
  "required": [
    "promoter_id"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "capogruppo"
          }
        },
        {
          "user_condition": {
            "role": "pr"
          }
        },
        {
          "user_condition": {
            "role": "super4"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "data.promoter_id": "{{user.data.promoter_id}}"
        }
      ]
    },
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "data.promoter_id": "{{user.data.promoter_id}}"
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "data.promoter_id": "{{user.data.promoter_id}}"
        }
      ]
    }
  },
  "type": "object"
}
